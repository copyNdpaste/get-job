POSTGRES_DB=jobdb
POSTGRES_USER=jobapp
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+psycopg://jobapp:local-development-only@db:5432/jobdb
POSTGRES_VOLUME_NAME=job-analyzer_postgres_data
APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=41739
BACKEND_CORS_ORIGINS=http://localhost:41739,http://127.0.0.1:41739
RESUME_DIRECTORY=/data/generated-resumes.local

# A local OpenAI-compatible model is the default. No external AI is contacted unless AI_ALLOW_REMOTE=true.
AI_ENABLED=true
AI_PROVIDER=openai-compatible
AI_BASE_URL=http://host.docker.internal:1234
AI_MODEL=auto
AI_ALLOW_REMOTE=false
AI_API_KEY=
AI_TIMEOUT_SECONDS=120

# Budgeted collected-job analysis. Keep local models by default.
# For an opted-in Codex bridge: fast=gpt-5.6-luna, review=gpt-5.6-terra.
AI_ANALYSIS_FAST_MODEL=auto
AI_ANALYSIS_REVIEW_MODEL=
AI_ANALYSIS_MAX_OUTPUT_TOKENS=1200
AI_ANALYSIS_PROMPT_BYTES=12000
# Conservative planning units, not a guaranteed provider billing cap.
AI_ANALYSIS_DAILY_BUDGET=100000
AI_ANALYSIS_DAILY_REVIEWS=5
AI_ANALYSIS_BATCH_SIZE=10
AI_ANALYSIS_BATCH_REVIEWS=2
AI_ANALYSIS_MIN_FIT=60
AI_ANALYSIS_AFTER_CRAWL=false

CRAWLER_CACHE_DIR=.cache/crawler
CRAWLER_DELAY_MIN_SECONDS=2
CRAWLER_DELAY_MAX_SECONDS=5
# Keep browser-backed collectors within typical local Docker memory limits.
CRAWLER_MAX_CONCURRENCY=2
CRAWLER_USER_AGENT=get-job/0.1 (+local personal job search)
DIRECT_ATS_BOARD_PATH=/data/ats-boards.local.json

# Optional: requires Saramin's official API application and approval.
# The key stays in the ignored local .env and is never sent to the frontend.
SARAMIN_API_KEY=

# Company size and funding are enriched from public GroupBy profiles.
# Add a free OpenDART key to enrich the latest three annual financial statements and staff count.
COMPANY_ENRICHMENT_MAX_GROUPBY=25
COMPANY_ENRICHMENT_MAX_DART=50
COMPANY_FACTS_REFRESH_DAYS=7
DART_API_KEY=
DART_CACHE_DIR=.cache/dart

# Daily collection runs at 10:00, 13:00, and 17:00 Asia/Seoul and stores recommendation history locally.
DAILY_DIGEST_ENABLED=true
DAILY_DIGEST_TIMES=10:00,13:00,17:00
DAILY_DIGEST_TIMEZONE=Asia/Seoul
DAILY_CRAWL_MAX_JOBS=5000
DAILY_RECOMMENDATION_LIMIT=10
DAILY_RECOMMENDATION_MIN_FIT=70
DAILY_RECOMMENDATION_MIN_VALUE=70
DAILY_RECOMMENDATION_COOLDOWN_DAYS=14

# External Slack delivery is an explicit local opt-in. Never commit real values.
SLACK_NOTIFY_ENABLED=false
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
